<svg xmlns="http://www.w3.org/2000/svg" width="600" height="450" viewBox="0 0 600 450">
  <!-- Background -->
  <rect width="600" height="450" fill="#f5f5f5"/>

  <!-- Map background with subtle gradient -->
  <rect x="50" y="50" width="500" height="350" fill="#e8f4f8" stroke="#2D2D2D" stroke-width="2" rx="8"/>

  <!-- Coastline approximation (Atlantic Ocean on left) -->
  <path d="M 80 100 Q 70 150 75 200 Q 70 250 80 300 Q 85 350 90 380"
        stroke="#4a90e2" stroke-width="3" fill="none" opacity="0.6"/>
  <rect x="50" y="50" width="30" height="350" fill="#b3d9ff" opacity="0.3"/>

  <!-- 30km radius circles from Milnerton (center point) -->
  <circle cx="200" cy="225" r="180" fill="none" stroke="#E31837" stroke-width="3" stroke-dasharray="10,5" opacity="0.7"/>
  <circle cx="200" cy="225" r="120" fill="none" stroke="#E31837" stroke-width="2" stroke-dasharray="5,3" opacity="0.4"/>
  <circle cx="200" cy="225" r="60" fill="none" stroke="#E31837" stroke-width="1" stroke-dasharray="3,2" opacity="0.3"/>

  <!-- Center point - Milnerton -->
  <circle cx="200" cy="225" r="8" fill="#E31837"/>
  <circle cx="200" cy="225" r="4" fill="white"/>

  <!-- Location markers (key suburbs within 30km) -->
  <!-- Northern Suburbs -->
  <circle cx="230" cy="180" r="5" fill="#FDB913"/>
  <circle cx="260" cy="160" r="5" fill="#FDB913"/>
  <circle cx="250" cy="200" r="5" fill="#FDB913"/>
  <circle cx="280" cy="190" r="5" fill="#FDB913"/>

  <!-- Atlantic Seaboard -->
  <circle cx="150" cy="250" r="5" fill="#FDB913"/>
  <circle cx="140" cy="280" r="5" fill="#FDB913"/>
  <circle cx="160" cy="300" r="5" fill="#FDB913"/>

  <!-- Southern Suburbs -->
  <circle cx="250" cy="280" r="5" fill="#FDB913"/>
  <circle cx="270" cy="300" r="5" fill="#FDB913"/>
  <circle cx="290" cy="260" r="5" fill="#FDB913"/>

  <!-- Table Mountain silhouette (iconic landmark) -->
  <path d="M 120 320 L 130 280 L 160 275 L 190 275 L 220 280 L 230 320 Z"
        fill="#2D2D2D" opacity="0.15"/>

  <!-- Major roads (simplified) -->
  <line x1="200" y1="100" x2="200" y2="350" stroke="#999" stroke-width="2" opacity="0.3"/>
  <line x1="120" y1="225" x2="350" y2="225" stroke="#999" stroke-width="2" opacity="0.3"/>

  <!-- Service area shading -->
  <circle cx="200" cy="225" r="180" fill="#E31837" opacity="0.08"/>

  <!-- Labels -->
  <text x="200" y="215" text-anchor="middle" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="#2D2D2D">MILNERTON</text>
  <text x="200" y="245" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" fill="#E31837">30km Service Radius</text>

  <!-- Geographic labels -->
  <text x="80" y="220" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#4a90e2" font-weight="bold">ATLANTIC</text>
  <text x="80" y="235" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" fill="#4a90e2" font-weight="bold">OCEAN</text>

  <text x="260" y="145" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#666">Durbanville</text>
  <text x="150" y="245" text-anchor="start" font-family="Arial, sans-serif" font-size="10" fill="#666">Sea Point</text>
  <text x="160" y="295" text-anchor="start" font-family="Arial, sans-serif" font-size="10" fill="#666">Camps Bay</text>
  <text x="250" y="275" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#666">Constantia</text>
  <text x="290" y="255" text-anchor="start" font-family="Arial, sans-serif" font-size="10" fill="#666">Claremont</text>
  <text x="230" y="175" text-anchor="start" font-family="Arial, sans-serif" font-size="10" fill="#666">Table View</text>
  <text x="280" y="185" text-anchor="start" font-family="Arial, sans-serif" font-size="10" fill="#666">Bellville</text>

  <!-- Compass rose -->
  <g transform="translate(480, 100)">
    <circle cx="0" cy="0" r="25" fill="white" stroke="#2D2D2D" stroke-width="2"/>
    <polygon points="0,-20 3,-5 0,-8 -3,-5" fill="#E31837"/>
    <text x="0" y="-28" text-anchor="middle" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="#2D2D2D">N</text>
    <text x="0" y="35" text-anchor="middle" font-family="Arial, sans-serif" font-size="10" fill="#666">S</text>
    <text x="28" y="5" text-anchor="start" font-family="Arial, sans-serif" font-size="10" fill="#666">E</text>
    <text x="-28" y="5" text-anchor="end" font-family="Arial, sans-serif" font-size="10" fill="#666">W</text>
  </g>

  <!-- Legend -->
  <g transform="translate(400, 320)">
    <rect x="0" y="0" width="140" height="70" fill="white" stroke="#2D2D2D" stroke-width="1" rx="4"/>
    <text x="70" y="15" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" font-weight="bold" fill="#2D2D2D">COVERAGE AREA</text>
    <circle cx="15" cy="30" r="4" fill="#E31837"/>
    <text x="25" y="34" font-family="Arial, sans-serif" font-size="9" fill="#333">Murtons Base</text>
    <circle cx="15" cy="45" r="4" fill="#FDB913"/>
    <text x="25" y="49" font-family="Arial, sans-serif" font-size="9" fill="#333">Suburb Served</text>
    <line x1="10" y1="58" x2="25" y2="58" stroke="#E31837" stroke-width="2" stroke-dasharray="4,2"/>
    <text x="30" y="62" font-family="Arial, sans-serif" font-size="9" fill="#333">30km Radius</text>
  </g>

  <!-- Title -->
  <text x="300" y="30" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#2D2D2D">Murtons Projects Service Coverage Map</text>
</svg>